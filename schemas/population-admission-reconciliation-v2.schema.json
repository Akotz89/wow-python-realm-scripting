{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.playerbots.invalid/schemas/population-admission-reconciliation-v2.schema.json",
  "title": "Owner-aware mutable admission reconciliation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "admission_control",
    "binding_count",
    "blocked_identities",
    "candidate_batch",
    "decision",
    "earliest_pending_wave",
    "owner_state",
    "pending_wave_levels",
    "realm_id",
    "reconciliation_digest",
    "reconciliation_schema",
    "reconciliation_version",
    "runtime_commit_required",
    "source_digests",
    "total_due_count",
    "wave_states"
  ],
  "properties": {
    "reconciliation_schema": { "const": 2 },
    "reconciliation_version": { "$ref": "#/$defs/token" },
    "realm_id": { "$ref": "#/$defs/token" },
    "reconciliation_digest": { "$ref": "#/$defs/digest" },
    "source_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_digest", "manifest_digest", "policy_digest", "schedule_digest", "snapshot_digest"],
      "properties": {
        "binding_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "schedule_digest": { "$ref": "#/$defs/digest" },
        "snapshot_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "owner_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_generation",
        "binding_state",
        "current_epoch",
        "newly_authorized_levels",
        "observed_owner_level",
        "owner_account_id",
        "owner_character_guid",
        "previous_highest_owner_level_seen",
        "resulting_highest_owner_level_seen"
      ],
      "properties": {
        "binding_generation": { "type": "integer", "minimum": 1 },
        "binding_state": { "enum": ["unbound", "bound"] },
        "current_epoch": { "type": "integer", "minimum": 1, "maximum": 80 },
        "newly_authorized_levels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 2, "maximum": 80 }
        },
        "observed_owner_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 80 },
        "owner_account_id": { "type": ["integer", "null"], "minimum": 1 },
        "owner_character_guid": { "type": ["integer", "null"], "minimum": 1 },
        "previous_highest_owner_level_seen": { "type": "integer", "minimum": 1, "maximum": 80 },
        "resulting_highest_owner_level_seen": { "type": "integer", "minimum": 1, "maximum": 80 }
      }
    },
    "admission_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admissions_paused", "available_creation_slots", "creation_batch_size", "pause_reason"],
      "properties": {
        "admissions_paused": { "type": "boolean" },
        "available_creation_slots": { "type": "integer", "minimum": 0 },
        "creation_batch_size": { "type": "integer", "minimum": 1 },
        "pause_reason": { "type": ["string", "null"] }
      }
    },
    "binding_count": { "type": "integer", "minimum": 0 },
    "total_due_count": { "type": "integer", "minimum": 0 },
    "pending_wave_levels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 80 }
    },
    "earliest_pending_wave": { "type": ["integer", "null"], "minimum": 1, "maximum": 80 },
    "decision": { "enum": ["admit_batch", "blocked_ineligible", "capacity_hold", "noop", "paused"] },
    "blocked_identities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "candidate_batch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["creation_wave_owner_level", "manifest_identity", "wave_ordinal"],
        "properties": {
          "creation_wave_owner_level": { "type": "integer", "minimum": 1, "maximum": 80 },
          "manifest_identity": { "$ref": "#/$defs/token" },
          "wave_ordinal": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "wave_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "admitted_count",
          "idempotency_key",
          "ineligible_remaining",
          "owner_level",
          "planned_count",
          "remaining_count",
          "state"
        ],
        "properties": {
          "admitted_count": { "type": "integer", "minimum": 0 },
          "idempotency_key": { "$ref": "#/$defs/digest" },
          "ineligible_remaining": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/token" }
          },
          "owner_level": { "type": "integer", "minimum": 1, "maximum": 80 },
          "planned_count": { "type": "integer", "minimum": 0 },
          "remaining_count": { "type": "integer", "minimum": 0 },
          "state": { "enum": ["active", "admitting", "authorized", "blocked"] }
        }
      }
    },
    "runtime_commit_required": { "const": true }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" }
  }
}
